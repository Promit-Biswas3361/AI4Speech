<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- White Background -->
    <solid android:color="@android:color/white" />

    <!-- Padding inside -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />

    <!-- Ensure the shape remains circular -->
    <size
        android:width="120dp"
        android:height="120dp" />

</shape>
