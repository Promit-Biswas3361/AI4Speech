<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BC000000"
        android:alpha="0.06"/>

    <!-- Navbar -->
    <LinearLayout
        android:id="@+id/navbar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@color/transparent_white"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="30dp">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="106dp"
            android:layout_height="80dp"
            android:contentDescription="App Logo"
            android:src="@drawable/app_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Profile"
            android:scaleType="fitCenter"
            android:src="@drawable/profile" />

        <ImageButton
            android:id="@+id/logoutButton"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/logout"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Logout"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- Profile Picture -->
    <ImageView
        android:id="@+id/profilePicture"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/default_profile"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="110dp"
        android:background="@drawable/circle_border"/>

    <!-- Edit Profile Picture Button -->
    <Button
        android:id="@+id/editProfilePicButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Profile Picture"
        android:layout_below="@id/profilePicture"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"/>

    <!-- Username -->
    <TextView
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_below="@id/editProfilePicButton"
        android:layout_centerHorizontal="true"/>

    <!-- Email (Readonly) -->
    <TextView
        android:id="@+id/userEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:layout_below="@id/userName"
        android:layout_centerHorizontal="true"/>

    <!-- Last Active -->
    <TextView
        android:id="@+id/lastActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:layout_below="@id/userEmail"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"/>

    <!-- Game Statistics -->
    <LinearLayout
        android:id="@+id/gameStatsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/lastActive"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/gameStatsHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Statistics"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:id="@+id/gameLevelsCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Levels Completed: "
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/gameAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Average Accuracy: "
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Speech Test Statistics -->
    <LinearLayout
        android:id="@+id/speechTestStatsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/gameStatsContainer"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/speechTestHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speech Test Statistics"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:id="@+id/speechTestsCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Tests Completed: "
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/speechTestAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Average Accuracy: "
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Edit Profile Button -->
    <Button
        android:id="@+id/editProfileButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:layout_below="@id/speechTestStatsContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>
</RelativeLayout>
